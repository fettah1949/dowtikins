# DowTikins Environment Variables

# If you want to use a custom API key for external services, add it here
# NEXT_PUBLIC_API_KEY=your_api_key_here

# Custom API endpoints (optional)
# TIKTOK_API_URL=https://your-custom-api.com/tiktok
# INSTAGRAM_API_URL=https://your-custom-api.com/instagram

# AdSense Configuration
# Get your AdSense Publisher ID from: https://www.google.com/adsense
# Replace ca-pub-XXXXXXXXXXXXXXXX with your actual AdSense Publisher ID
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_DISABLE_ADS=false
